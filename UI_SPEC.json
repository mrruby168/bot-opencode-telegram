{
 "app": "tele-commander",
 "version": "5.0-2features",
 "chat": {
  "messageLimit": 4000,
  "noParseMode": true,
  "plainTextOnly": true,
  "buttons": {
   "menuTitle": "Chọn tác vụ:",
   "menuLayout": "1-1-1",
   "menu": [
    {
     "text": "Tắt máy sau 30s",
     "data": "go:pc:now"
    },
    {
     "text": "Chụp màn hình PC",
     "data": "go:pc:shot"
    },
    {
     "text": "Link Web (WiFi)",
     "data": "go:web:link"
    }
   ],
   "confirmShutdown": [
    {
     "text": "YES - Tắt máy",
     "data": "pw:yes:<nonce>"
    },
    {
     "text": "NO - Hủy",
     "data": "pw:no:<nonce>"
    }
   ],
   "serviceDown": [
    {
     "text": "Bật lại",
     "data": "web:start:<nonce>"
    },
    {
     "text": "Không",
     "data": "web:skip:<nonce>"
    }
   ],
   "restartForLan": [
    {
     "text": "Tiếp tục",
     "data": "web:go:<nonce>"
    },
    {
     "text": "Huỷ",
     "data": "web:cancel:<nonce>"
    }
   ]
  },
  "commands": [
   {
    "command": "/start",
    "description": "Mở menu bot"
   },
   {
    "command": "/web",
    "description": "Link web OpenCode (WiFi)"
   },
   {
    "command": "/shot",
    "description": "Chụp màn hình PC"
   },
   {
    "command": "/cancel_shutdown",
    "description": "Hủy lệnh tắt máy"
   },
   {
    "command": "/status",
    "description": "Trạng thái bot + CLI V2"
   }
  ],
  "flows": {
   "shutdown": "Bấm Tắt máy sau 30s → YES/NO (TTL 60s) → shutdown.exe /s /t 30; /cancel_shutdown để hủy.",
   "screenshot": "Bấm Chụp màn hình PC → ảnh về Telegram; nút Gửi bản gốc (file).",
   "weblink": "Bấm Link Web (WiFi) → (service DOWN: hỏi Bật lại) → (host 127.0.0.1: cảnh báo restart) → firewall → IP LAN → pair --url → gửi link dùng 1 lần, hết hạn 5 phút."
  }
 },
 "accessibility": {
  "labels": "Mỗi nút có nhãn tiếng Việt rõ nghĩa",
  "notColorOnly": true
 },
 "access": "Chỉ TELEGRAM_ALLOWED_USERS; người lạ bị im lặng."
}
