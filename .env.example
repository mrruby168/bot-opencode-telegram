# Copy sang .env va dien that - KHONG commit .env
TELEGRAM_BOT_TOKEN=put-your-token-here
# Danh sach Telegram user id duoc phep dung bot (cach nhau dau phay)
TELEGRAM_ALLOWED_USERS=
# Duong dan CLI V2 cua OpenCode Desktop. De trong = tu do %APPDATA%\ai.opencode.desktop\cli\*
# Desktop update version moi thi sua dong nay
OPENCODE_V2_CLI=C:\Users\mrrub\AppData\Roaming\ai.opencode.desktop\cli\2.2.5-x64\opencode-cli.exe
# Chi dien khi may nhieu card mang (VPN/Hyper-V/VMware)
WEB_LAN_IP=
# Timeout lenh pair lay link (ms)
PAIR_TIMEOUT_MS=60000
